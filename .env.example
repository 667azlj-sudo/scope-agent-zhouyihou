# Scope Agent 环境变量示例（复制为 .env 并填入真实值，或由部署平台注入）
# 注意：后端目前不内置 .env 加载器，请通过 shell export 或部署平台的 Secret 注入。

# ---- 大模型 ----
# DeepSeek 云端 API Key（设置了则优先走云端，否则回退本地 Ollama）
DEEPSEEK_API_KEY=

# ---- 短信（阿里云，未配齐则自动退回模拟模式）----
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_CODE=

# ---- 会话与验证码 ----
# 会话有效期（小时），默认 168（7 天）
SESSION_TTL_HOURS=168
# 同一手机号验证码重发间隔（秒），默认 60
SMS_RESEND_SECONDS=60

# ---- CORS ----
# 允许的前端来源，逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 上传 ----
# 单文件上传大小上限（字节），默认 20MB
MAX_UPLOAD_BYTES=20971520

# ---- 数据库 ----
# 设置后走 PostgreSQL；留空则回退 SQLite（本地开发）
DATABASE_URL=
# docker-compose 中的 postgres 账号（配合 DATABASE_URL 使用）
POSTGRES_USER=scope
POSTGRES_PASSWORD=scope
POSTGRES_DB=scope_agent

# ---- 服务 ----
# 监听地址（内网部署设为 0.0.0.0）
HOST=127.0.0.1
